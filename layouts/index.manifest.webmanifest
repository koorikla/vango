{{- /* ------------------------------------------------------------------
     The web app manifest, rendered once per language.

     `.RelPermalink` inside a non-HTML output template is that output's own
     URL — the manifest file — so the HTML permalink is asked for by name.
     ------------------------------------------------------------------ */ -}}
{{- $d := index hugo.Data site.Language.Lang "site" -}}
{{- $icons := partial "icons.html" . -}}
{{- $home := (.OutputFormats.Get "html").RelPermalink -}}

{{- $list := slice -}}
{{- with $icons.small }}
  {{- $list = $list | append (dict "src" .RelPermalink "sizes" "192x192" "type" "image/png" "purpose" "any") -}}
{{- end -}}
{{- with $icons.large }}
  {{- $list = $list | append (dict "src" .RelPermalink "sizes" "512x512" "type" "image/png" "purpose" "any") -}}
{{- end -}}
{{- with $icons.maskable }}
  {{- $list = $list | append (dict "src" .RelPermalink "sizes" "512x512" "type" "image/png" "purpose" "maskable") -}}
{{- end -}}

{{- /* `scope` is the whole site rather than this language's corner of it, so
       that following the language switch from a home-screen copy stays in
       the same window instead of throwing the reader out to a browser tab.
       `id` is what keeps the two languages apart as separate installs.

       `minimal-ui`, not `standalone`: this is a dozen pages a reader moves
       between, and taking the back button away from them to look like an
       app would be a straight loss. */ -}}
{{- dict
      "id"               $home
      "name"             site.Title
      "short_name"       "Vango"
      "description"      $d.meta.description
      "lang"             site.Language.Locale
      "dir"              "ltr"
      "start_url"        $home
      "scope"            (index hugo.Sites 0).Home.RelPermalink
      "display"          "minimal-ui"
      "orientation"      "portrait-primary"
      "background_color" "#fdfaf6"
      "theme_color"      "#fdfaf6"
      "icons"            $list
   | jsonify (dict "indent" "  ") -}}
